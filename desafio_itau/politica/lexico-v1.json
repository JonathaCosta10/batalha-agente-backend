      "acao": "bloquear_se_afirmativo",
      "padroes": ["(?:so|somente|apenas) hoje", "ultima chance", "ultimas vagas", "imperdivel", "agora ou nunca", "nao perca (?:essa|esta) (?:oportunidade|chance)", "corra (?:e|para) (?:contrat|garant|aproveit)\\w*", "aproveite (?:ja|agora)"],
      "permite_negacao": false,
      "permite_citacao": true,
      "motivo": "Urgência artificial e pressão comercial.",
      "exemplos_bloqueados": ["Última chance: aproveite já!"],
      "exemplos_permitidos": ["Desconfie de anúncios com \"última chance\"."]
