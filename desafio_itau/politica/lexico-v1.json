      "categoria": "julgamento",
      "acao": "bloquear_se_afirmativo",
      "padroes": ["voce e (?:muito |bem |uma? )?(?:irresponsavel|descontrolad[oa]|gastador[a]?|esbanjador[a]?|consumista|desorganizad[oa]|preguicos[oa]|imprudente|relaxad[oa])", "(?:sua|tua) (?:falta de|ausencia de) (?:controle|disciplina|responsabilidade)", "(?:a )?culpa e (?:sua|tua|toda sua)", "voce (?:nao tem|tem zero) (?:controle|disciplina|juizo)", "vergonha de (?:gastar|dever)"],
      "permite_negacao": true,
      "permite_citacao": false,
      "motivo": "Julgamento moral da pessoa; substituir por observação objetiva sustentada pelos dados.",
      "exemplos_bloqueados": ["Você é irresponsável com dinheiro.", "A culpa é sua."],
      "exemplos_permitidos": ["Isso não é culpa sua.", "Neste período, as saídas registradas superaram as entradas."]
