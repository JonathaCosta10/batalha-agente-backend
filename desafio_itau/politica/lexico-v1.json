      "acao": "bloquear_se_afirmativo",
      "padroes": ["\\bvulneravel\\b", "\\besbanjador[a]?\\b", "\\b(?:perfil|segmento|cluster|grupo) (?:t3|livre|saudavel|vulneravel|esbanjador[a]?)\\b", "\\bperfil_t3\\b", "\\bt3\\b"],
      "permite_negacao": false,
      "permite_citacao": false,
      "motivo": "Rótulo interno de segmentação (t3.py: Vulnerável, Esbanjador, Livre). Orienta o tom no servidor; nunca aparece no texto ao cliente, nem negado (\"você não é vulnerável\" também expõe o rótulo). Achado D2 da sessão d9, 2026-09-27.",
      "exemplos_bloqueados": ["Seu perfil é Vulnerável.", "Você não é esbanjador.", "Você está no segmento Livre."],
